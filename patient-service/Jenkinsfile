pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '774118824657.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = '774118824657.dkr.ecr.ap-south-1.amazonaws.com/patient-service'
        AWS_CREDENTIALS = 'aws-patient-service'

        IMAGE_TAG = "${BUILD_NUMBER}"

        LAUNCH_TEMPLATE_ID = 'lt-0e1a3ca54608fee29'
        ASG_NAME = 'patient-service-asg'

        HEALTH_URL = 'http://patient-service-alb-677738985.ap-south-1.elb.amazonaws.com/actuator/health'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                withEnv([
                        'SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5433/postgres',
                        'SPRING_DATASOURCE_USERNAME=postgres',
                        'SPRING_DATASOURCE_PASSWORD=postgres'
                    ]) {
                    dir('patient-service') {
                        sh '''
                            set -e
                            mvn -B clean test
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('patient-service') {
                    echo "Building Docker image: ${ECR_REPOSITORY}:${IMAGE_TAG}"

                    sh '''
                        set -e

                        docker build \
                            --platform linux/amd64 \
                            -t ${ECR_REPOSITORY}:${IMAGE_TAG} .
                    '''

                    sh '''
                        docker image inspect ${ECR_REPOSITORY}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {
                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region ${AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${ECR_REGISTRY}
                    '''
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    set -e

                    echo "Pushing image:"
                    echo "${ECR_REPOSITORY}:${IMAGE_TAG}"

                    docker push ${ECR_REPOSITORY}:${IMAGE_TAG}
                '''
            }
        }

        stage('Create Launch Template Version') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Creating Launch Template version"
                        echo "======================================"

                        echo "Launch Template: ${LAUNCH_TEMPLATE_ID}"
                        echo "Image tag:       ${IMAGE_TAG}"
                        echo "Build number:    ${BUILD_NUMBER}"

                        if [ -z "${LAUNCH_TEMPLATE_ID}" ]; then
                            echo "ERROR: LAUNCH_TEMPLATE_ID is empty"
                            exit 1
                        fi

                        if [ -z "${IMAGE_TAG}" ]; then
                            echo "ERROR: IMAGE_TAG is empty"
                            exit 1
                        fi

                        echo "Generating User Data..."

                        sed "s/__IMAGE_TAG__/${IMAGE_TAG}/g" \
                            patient-service/aws/user-data.sh \
                            > generated-user-data.sh

                        echo "Generated User Data:"
                        cat generated-user-data.sh

                        echo "Encoding User Data..."

                        USER_DATA=$(base64 -w 0 generated-user-data.sh)

                        if [ -z "${USER_DATA}" ]; then
                            echo "ERROR: User Data encoding failed"
                            exit 1
                        fi

                        echo "Creating new Launch Template version..."

                        NEW_VERSION=$(aws ec2 create-launch-template-version \
                            --launch-template-id "${LAUNCH_TEMPLATE_ID}" \
                            --source-version '$Default' \
                            --version-description "Jenkins build ${BUILD_NUMBER} - image ${IMAGE_TAG}" \
                            --launch-template-data "{\"UserData\":\"${USER_DATA}\"}" \
                            --region "${AWS_REGION}" \
                            --query 'LaunchTemplateVersion.VersionNumber' \
                            --output text)

                        if [ -z "${NEW_VERSION}" ] || [ "${NEW_VERSION}" = "None" ]; then
                            echo "ERROR: Failed to create Launch Template version"
                            exit 1
                        fi

                        echo "New Launch Template version: ${NEW_VERSION}"

                        echo "${NEW_VERSION}" > new_lt_version.txt

                        echo "Launch Template version saved."
                    '''
                }
            }
        }

        stage('Update Auto Scaling Group') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Updating Auto Scaling Group"
                        echo "======================================"

                        if [ ! -f new_lt_version.txt ]; then
                            echo "ERROR: new_lt_version.txt not found"
                            exit 1
                        fi

                        NEW_VERSION=$(cat new_lt_version.txt)

                        echo "ASG: ${ASG_NAME}"
                        echo "Launch Template: ${LAUNCH_TEMPLATE_ID}"
                        echo "Version: ${NEW_VERSION}"

                        aws autoscaling update-auto-scaling-group \
                            --auto-scaling-group-name "${ASG_NAME}" \
                            --launch-template \
                                LaunchTemplateId="${LAUNCH_TEMPLATE_ID}",Version="${NEW_VERSION}" \
                            --region "${AWS_REGION}"

                        echo "ASG updated successfully."
                    '''
                }
            }
        }

        stage('Start Instance Refresh') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Starting Instance Refresh"
                        echo "======================================"

                        REFRESH_ID=$(aws autoscaling start-instance-refresh \
                            --auto-scaling-group-name "${ASG_NAME}" \
                            --preferences MinHealthyPercentage=100,InstanceWarmup=120 \
                            --region "${AWS_REGION}" \
                            --query 'InstanceRefreshId' \
                            --output text)

                        if [ -z "${REFRESH_ID}" ] || [ "${REFRESH_ID}" = "None" ]; then
                            echo "ERROR: Instance Refresh was not created"
                            exit 1
                        fi

                        echo "Instance Refresh started:"
                        echo "${REFRESH_ID}"

                        echo "${REFRESH_ID}" > refresh_id.txt
                    '''
                }
            }
        }

        stage('Wait For Deployment') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {
                    sh '''
                        set -e

                        REFRESH_ID=$(cat refresh_id.txt)

                        echo "======================================"
                        echo "Waiting for Instance Refresh"
                        echo "======================================"

                        echo "Refresh ID: ${REFRESH_ID}"

                        for i in $(seq 1 60); do

                            STATUS=$(aws autoscaling describe-instance-refreshes \
                                --auto-scaling-group-name "${ASG_NAME}" \
                                --instance-refresh-ids "${REFRESH_ID}" \
                                --region "${AWS_REGION}" \
                                --query 'InstanceRefreshes[0].Status' \
                                --output text)

                            echo "Attempt ${i}/60"
                            echo "Instance Refresh status: ${STATUS}"

                            case "${STATUS}" in

                                Successful)
                                    echo "Deployment completed successfully."
                                    exit 0
                                    ;;

                                Failed|Cancelled|RollbackFailed)
                                    echo "Deployment failed with status: ${STATUS}"
                                    exit 1
                                    ;;

                                Pending|InProgress)
                                    echo "Deployment still in progress..."
                                    sleep 20
                                    ;;

                                *)
                                    echo "Unknown status: ${STATUS}"
                                    sleep 20
                                    ;;

                            esac

                        done

                        echo "Deployment timed out."
                        exit 1
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {

                    timeout(time: 3, unit: 'MINUTES') {

                        waitUntil {

                            def status = sh(
                                script: """
                                    curl -s \
                                         -o /tmp/health.json \
                                         -w "%{http_code}" \
                                         ${HEALTH_URL}
                                """,
                                returnStdout: true
                            ).trim()

                            def response = sh(
                                script: """
                                    cat /tmp/health.json
                                """,
                                returnStdout: true
                            ).trim()

                            echo "HTTP Status: ${status}"
                            echo "Health Response: ${response}"

                            if (status == '200' &&
                                response.contains('"status":"UP"')) {

                                echo "Application health check passed."

                                return true
                            }

                            echo "Application is not healthy yet."
                            echo "Waiting 10 seconds..."

                            sleep 10

                            return false
                        }
                    }
                }
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "CI/CD PIPELINE SUCCESS"
            echo "======================================"

            echo "Image: ${ECR_REPOSITORY}:${IMAGE_TAG}"
        }

        failure {
            echo "======================================"
            echo "CI/CD PIPELINE FAILED"
            echo "======================================"
        }

        always {
            sh '''
                docker logout ${ECR_REGISTRY} || true
            '''
        }
    }
}