pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '774118824657.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = '774118824657.dkr.ecr.ap-south-1.amazonaws.com/patient-service'
        AWS_CREDENTIALS = 'aws-patient-service'
        IMAGE_TAG = "${BUILD_NUMBER}"
        LAUNCH_TEMPLATE_ID = 'lt-0e1a3ca54608fee29'
        ASG_NAME = 'patient-service-asg'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                withEnv([
                        'SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5433/postgres',
                        'SPRING_DATASOURCE_USERNAME=postgres',
                        'SPRING_DATASOURCE_PASSWORD=postgres'
                    ]) {
                    dir('patient-service') {
                        sh ''
                        '
                        mvn - B clean test ''
                        '
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('patient-service') {
                    sh ''
                    '
                    docker build--platform linux / amd64\ -
                    t $ {
                        ECR_REPOSITORY
                    }: $ {
                        IMAGE_TAG
                    }.
                    ''
                    '
                }
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {
                    sh ''
                    '
                    aws ecr get - login - password\
                    --region $ {
                        AWS_REGION
                    } | \
                    docker login\
                    --username AWS\
                    --password - stdin $ {
                        ECR_REGISTRY
                    }
                    ''
                    '
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh ''
                '
                docker push $ {
                    ECR_REPOSITORY
                }: $ {
                    IMAGE_TAG
                }
                ''
                '
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {
                    script {
                        sh ''
                        '
                        echo "Creating new Launch Template version..."

                        # Your existing commands that create the new
                        # Launch Template version should remain here.

                        echo "Updating ASG..."

                        # Your existing ASG update command should remain here.
                        ''
                        '

                        def refreshId = sh(
                            script: ''
                            '
                            aws autoscaling start - instance - refresh\
                            --auto - scaling - group - name patient - service - asg\
                            --preferences MinHealthyPercentage = 100, InstanceWarmup = 120\
                            --region $ {
                                AWS_REGION
                            }\
                            --query 'InstanceRefreshId'\
                            --output text ''
                            ',
                            returnStdout: true
                        ).trim()

                        echo "Instance Refresh started: ${refreshId}"

                        timeout(time: 15, unit: 'MINUTES') {
                            waitUntil {
                                def status = sh(
                                    script: ""
                                    "
                                    aws autoscaling describe - instance - refreshes\
                                    --auto - scaling - group - name patient - service - asg\
                                    --instance - refresh - ids $ {
                                        refreshId
                                    }\
                                    --region $ {
                                        AWS_REGION
                                    }\
                                    --query 'InstanceRefreshes[0].Status'\
                                    --output text ""
                                    ",
                                    returnStdout: true
                                ).trim()

                                echo "Instance Refresh status: ${status}"

                                if (status == 'Successful') {
                                    return true
                                }

                                if (status in ['Failed', 'Cancelled']) {
                                    error("Instance Refresh failed with status: ${status}")
                                }

                                sleep 20
                                return false
                            }
                        }

                        echo "Instance Refresh completed successfully."
                    }
                }
            }
        }

        stage('Update Auto Scaling Group') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {
                    sh ''
                    '
                    set - e

                    NEW_VERSION = $(cat new_lt_version.txt)

                    echo "Updating ASG to Launch Template version ${NEW_VERSION}..."

                    aws autoscaling update - auto - scaling - group\
                    --auto - scaling - group - name $ {
                        ASG_NAME
                    }\
                    --launch - template\
                    LaunchTemplateId = $ {
                        LAUNCH_TEMPLATE_ID
                    }, Version = $ {
                        NEW_VERSION
                    }\
                    --region $ {
                        AWS_REGION
                    }

                    echo "ASG updated successfully."
                    ''
                    '
                }
            }
        }

        stage('Start Instance Refresh') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {
                    sh ''
                    '
                    set - e

                    echo "Starting Instance Refresh..."

                    REFRESH_ID = $(aws autoscaling start - instance - refresh\
                        --auto - scaling - group - name $ {
                            ASG_NAME
                        }\
                        --preferences MinHealthyPercentage = 100, InstanceWarmup = 120\
                        --region $ {
                            AWS_REGION
                        }\
                        --query 'InstanceRefreshId'\
                        --output text)

                    echo "Instance Refresh started: ${REFRESH_ID}"

                    echo "${REFRESH_ID}" > refresh_id.txt ''
                    '
                }
            }

        }
        stage('Wait For Deployment') {
            steps {
                withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {
                    sh ''
                    '
                    set - e

                    REFRESH_ID = $(cat refresh_id.txt)

                    echo "Waiting for Instance Refresh ${REFRESH_ID}..."

                    for i in $(seq 1 60);
                    do

                    STATUS = $(aws autoscaling describe - instance - refreshes\
                        --auto - scaling - group - name $ {
                            ASG_NAME
                        }\
                        --instance - refresh - ids $ {
                            REFRESH_ID
                        }\
                        --region $ {
                            AWS_REGION
                        }\
                        --query 'InstanceRefreshes[0].Status'\
                        --output text)

                    echo "Instance Refresh status: ${STATUS}"

                    case "$STATUS" in

                    Successful)
                echo "Deployment completed successfully."
                exit 0
                ;;

                Failed | Cancelled | RollbackFailed)
            echo "Deployment failed with status: ${STATUS}"
            exit 1
            ;;

            *)
        sleep 20
        ;;
        esac

        done

        echo "Deployment timed out."
        exit 1
        ''
        '
    }
}
}
}

stage('Verify Deployment') {
    steps {
        script {
            def healthUrl = 'http://patient-service-alb-677738985.ap-south-1.elb.amazonaws.com/actuator/health'

            timeout(time: 3, unit: 'MINUTES') {
                waitUntil {
                    def status = sh(
                        script: ""
                        "
                        curl - s - o / tmp / health.json\ -
                        w "%{http_code}"\
                        $ {
                            healthUrl
                        }
                        ""
                        ",
                        returnStdout: true
                    ).trim()

                    def response = sh(
                        script: "cat /tmp/health.json",
                        returnStdout: true
                    ).trim()

                    echo "HTTP Status: ${status}"
                    echo "Health Response: ${response}"

                    if (status == '200' && response.contains('"status":"UP"')) {
                        return true
                    }

                    echo "Application is not healthy yet. Waiting..."
                    sleep 10
                    return false
                }
            }

            echo "Application health check passed."
        }
    }
}

post {
    success {
        echo "CI pipeline completed successfully."
        echo "Image: ${ECR_REPOSITORY}:${IMAGE_TAG}"
    }

    failure {
        echo "CI pipeline failed."
    }

    always {
        sh 'docker logout ${ECR_REGISTRY} || true'

    }
}
}